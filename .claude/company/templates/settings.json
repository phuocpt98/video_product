{
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(python:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/cookies.json)",
      "Bash(cat .env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/company/hooks/check_file_placement.py\""
          }
        ]
      }
    ]
  }
}
